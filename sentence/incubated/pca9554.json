 "test_ops": [
  "#include \"rt.h\"\n#include \"pca9554.h\"\n\n/* Test read_input_pins: P4..P7 are inputs at power-on and the hub drives them\n   through the knobs. Reports each level and the high nibble. */\nvoid op_main(void)\n{\n    unsigned lv = 0;\n    unsigned n;\n    static const char *const keys[4] = {\"p4\", \"p5\", \"p6\", \"p7\"};\n\n    if (pca9554_read(0x20, &lv)) {\n        fail(\"pca9554_read failed\");\n        return;\n    }\n    for (n = 0; n < 4u; n++) {\n        report_str(keys[n], ((lv >> (4u + n)) & 1u) ? \"high\" : \"low\");\n    }\n    report_int(\"hi_nibble\", (long)((lv >> 4) & 0x0Fu));\n}\n",
  "#include \"rt.h\"\n#include \"pca9554.h\"\n\n/* Test set_one_pin: drives P_PIN to P_LEVEL, reads it back and checks that\n   no other pin moved. The hub also checks the pin's knob after the run. */\nvoid op_main(void)\n{\n    unsigned before = 0, after = 0;\n    unsigned mask = 1u << P_PIN;\n    unsigned diff, cnt = 0, n;\n\n    if (pca9554_read(0x20, &before)) {\n        fail(\"pca9554_read (before) failed\");\n        return;\n    }\n    if (pca9554_set_pin(0x20, P_PIN, P_LEVEL)) {\n        fail(\"pca9554_set_pin failed\");\n        return;\n    }\n    if (pca9554_read(0x20, &after)) {\n        fail(\"pca9554_read (after) failed\");\n        return;\n    }\n\n    report_int(\"level\", (long)((after & mask) ? 1 : 0));\n\n    diff = (before ^ after) & ~mask & 0xFFu;\n    for (n = 0; n < 8u; n++) {\n        if ((diff >> n) & 1u) cnt++;\n    }\n    report_int(\"others_changed\", (long)cnt);\n}\n"
 ],
