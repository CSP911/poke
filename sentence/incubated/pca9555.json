{
 "name": "pca9555",
 "addr": "0x24",
 "part": "PCA9555 (TCA9555/TCA9535-compatible)",
 "identity": "16-bit I2C GPIO expander",
 "fragment_part": null,
 "confidence": 0.85,
 "evidence": "regs 0-3 read FF, 4-5 read 00, 6-7 read FF, >=8 absent (PCA9555 reset map); config6=0x0F + output2=0xA5 gives input0=0xAF; polarity4=0xFF inverts input0 to 0x00; port1 outputs 0x3C read back 0x3C; plain write not reflected on read (not PCF8574)",
 "registers": "0/1 input P0/P1, 2/3 output (reset FF), 4/5 polarity inversion (reset 00), 6/7 config 1=input (reset FF); 8-bit registers",
 "learned": "2026-10-13 13:10",
 "by": "Claude Code CLI (claude -p / agent with probe.py only)",
 "bench": "lab",
 "functions": [
  {
   "sig": "static int pca9555_read(unsigned addr, unsigned *pins)",
   "doc": "reads all 16 pin levels into *pins: bit i = P0.i for i 0-7, bit 8+i = P1.i; clears polarity inversion first so 1 = high; 0 = ok",
   "access": "read",
   "write_regs": [
    4,
    5
   ],
   "max_write": 2,
   "policy": "allow"
  },
  {
   "sig": "static int pca9555_set_pin(unsigned addr, unsigned pin, unsigned level)",
   "doc": "makes pin 0-15 (0-7 = P0.0-P0.7, 8-15 = P1.0-P1.7) an output and drives it low (level 0) or high (level != 0); leaves the other pins as they were; 0 = ok, 1 = pin > 15",
   "access": "write",
   "write_regs": [
    2,
    3,
    6,
    7
   ],
   "max_write": 2,
   "policy": "confirm"
  },
  {
   "sig": "static int pca9555_identify(unsigned addr)",
   "doc": "read only; there is no ID register, so it checks the power-on map (output 2/3 = FF, polarity 4/5 = 00, config 6/7 = FF): 1 = PCA9555, 0 = not it or no ACK, -1 = polarity is 00 but outputs/config have been changed since power-on, so it cannot tell",
   "access": "read",
   "write_regs": [],
   "max_write": 1,
   "policy": "allow"
  }
 ],
