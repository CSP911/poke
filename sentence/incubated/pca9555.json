 "test_ops": [
  "#include \"rt.h\"\n#include \"pca9555.h\"\n\n/* test: drive_one_pin — every other pin stays an input (reads high on the twin).\n * First drive P_PIN low: exactly that bit must drop. Then drive it to P_VAL.\n * A wrong pin, wrong port or wrong bit order shows up as a different 16-bit value. */\nvoid op_main(void)\n{\n    unsigned v = 0;\n    int e;\n\n    e = pca9555_set_pin(0x24, P_PIN, 0);\n    if (e) { fail(\"pca9555_set_pin low failed\"); return; }\n    e = pca9555_read(0x24, &v);\n    if (e) { fail(\"pca9555_read failed\"); return; }\n    report_int(\"low_inputs\", (long)v);\n\n    e = pca9555_set_pin(0x24, P_PIN, P_VAL);\n    if (e) { fail(\"pca9555_set_pin failed\"); return; }\n    e = pca9555_read(0x24, &v);\n    if (e) { fail(\"pca9555_read failed\"); return; }\n    report_int(\"inputs\", (long)v);\n    report_int(\"pin\", (long)((v >> P_PIN) & 1u));\n    report_int(\"rest\", (long)((v | (1u << P_PIN)) & 0xFFFFu) - (long)(1u << P_PIN));\n    say(\"drove one pin\");\n}\n",
  "#include \"rt.h\"\n#include \"pca9555.h\"\n\n/* test: drive_pattern — drive all 16 pins to the bits of P_PAT, one set_pin per pin,\n * then read all pins back; an output pin reads its driven level on the input register. */\nvoid op_main(void)\n{\n    unsigned pat = (unsigned)(P_PAT) & 0xFFFFu;\n    unsigned v = 0, i;\n    int e;\n\n    for (i = 0; i < 16u; i++) {\n        e = pca9555_set_pin(0x24, i, (pat >> i) & 1u);\n        if (e) { fail(\"pca9555_set_pin failed\"); return; }\n    }\n    e = pca9555_read(0x24, &v);\n    if (e) { fail(\"pca9555_read failed\"); return; }\n    report_int(\"inputs\", (long)v);\n    report_int(\"port0\", (long)(v & 0xFFu));\n    report_int(\"port1\", (long)((v >> 8) & 0xFFu));\n    say(\"drove a 16-pin pattern\");\n}\n"
 ],
