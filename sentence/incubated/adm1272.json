{
 "name": "adm1272",
 "addr": "0x10",
 "part": "ADM1272",
 "identity": "PMBus hot-swap controller / power monitor (Analog Devices)",
 "fragment_part": null,
 "confidence": 0.95,
 "evidence": "PMBus command codes answer: 0x98 PMBUS_REVISION=0x22; block 0x99 MFR_ID = 03 'ADI'; block 0x9A MFR_MODEL = 0A 'ADM1272-A1'; 0x9B MFR_REVISION = 02 '25'; 0x01 OPERATION=0x80; 0x20 VOUT_MODE=0x40 (direct); 0xD4 PMON_CONFIG=0x3F35",
 "registers": "PMBus: 0x01 OPERATION, 0x20 VOUT_MODE, 0x78/0x79 STATUS (0), 0x88 READ_VIN, 0x8B READ_VOUT, 0x8C READ_IOUT, 0x8D READ_TEMP1, 0x97 READ_PIN, 0x98-0x9B PMBus revision/MFR blocks, 0xD3 PMON_CONTROL=0x0101, 0xD4 PMON_CONFIG (bit5 VRANGE=100V, bit0 IRANGE=30mV, bit3 TEMP1_EN=0). Words little-endian, direct format X=(Y*10^-R - b)/m: V m=4062 b=0 R=-2; I m=663*Rs(mOhm) b=20480 R=-1; P m=10535*Rs R=-3",
 "learned": "2026-10-13 13:06",
 "by": "Claude Code CLI (claude -p / agent with probe.py only)",
 "bench": "lab",
 "functions": [
  {
   "sig": "static int adm1272_identify(unsigned addr)",
   "doc": "Returns 1 if MFR_ID (0x99) is the block 'ADI' and MFR_MODEL (0x9A, read whole: count 10 + 10 bytes) starts with 'ADM1272', 0 if not, negative if the bus failed. Reads whole blocks so no bytes stay queued in the part.",
   "access": "read",
   "write_regs": [],
   "max_write": 1,
   "policy": "allow"
  },
  {
   "sig": "static int adm1272_read_word(unsigned addr, unsigned cmd, unsigned *raw)",
   "doc": "Reads the raw little-endian PMBus word at cmd (0x88 VIN, 0x8B VOUT, 0x8C IOUT, 0x97 PIN, 0xD4 PMON_CONFIG). 0 = ok, or the i2c error.",
   "access": "read",
   "write_regs": [],
   "max_write": 1,
   "policy": "allow"
  },
  {
   "sig": "static int adm1272_read_vi(unsigned addr, unsigned long rs_uohm, long *vin_mv, long *vout_mv, long *iout_ma)",
   "doc": "Reads VIN and VOUT in mV (0..100000) and IOUT in mA (signed). rs_uohm = sense resistor in µΩ (the bench twin uses 300). Ranges from PMON_CONFIG. 0 = ok, 1 if rs = 0, or the i2c error.",
   "access": "read",
   "write_regs": [],
   "max_write": 1,
   "policy": "allow"
  },
  {
   "sig": "static int adm1272_read_pin(unsigned addr, unsigned long rs_uohm, long *pin_mw)",
   "doc": "Reads input power in mW. rs_uohm = sense resistor in µΩ (the bench twin uses 300). 0 = ok, 1 if rs = 0, or the i2c error.",
   "access": "read",
   "write_regs": [],
   "max_write": 1,
   "policy": "allow"
  }
