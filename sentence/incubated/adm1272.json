 "test_ops": [
  "#include \"rt.h\"\n#include \"adm1272.h\"\n\n#define ADDR 0x10\n#define RS_UOHM 300UL\n\nvoid op_main(void)\n{\n    unsigned raw;\n    long vin, vout, iout;\n    int e;\n\n    e = adm1272_identify(ADDR);\n    if (e != 1) { fail(\"not an ADM1272 at 0x10\"); return; }\n\n    if (adm1272_read_word(ADDR, ADM1272_READ_VIN, &raw)) { fail(\"vin raw read\"); return; }\n    report_int(\"vin_raw\", (long)raw);\n    if (adm1272_read_word(ADDR, ADM1272_READ_VOUT, &raw)) { fail(\"vout raw read\"); return; }\n    report_int(\"vout_raw\", (long)raw);\n    if (adm1272_read_word(ADDR, ADM1272_READ_IOUT, &raw)) { fail(\"iout raw read\"); return; }\n    report_int(\"iout_raw\", (long)raw);\n\n    e = adm1272_read_vi(ADDR, RS_UOHM, &vin, &vout, &iout);\n    if (e) { fail(\"read_vi failed\"); return; }\n    report_int(\"vin_mv\", vin);\n    report_int(\"vout_mv\", vout);\n    report_int(\"iout_ma\", iout);\n    report_fixed(\"vin_v\", vin, 3);\n    report_fixed(\"iout_a\", iout, 3);\n}\n",
  "#include \"rt.h\"\n#include \"adm1272.h\"\n\n#define ADDR 0x10\n#define RS_UOHM 300UL\n\nvoid op_main(void)\n{\n    unsigned raw;\n    long pin, vin, vout, iout;\n    int e;\n\n    e = adm1272_identify(ADDR);\n    if (e != 1) { fail(\"not an ADM1272 at 0x10\"); return; }\n\n    if (adm1272_read_word(ADDR, ADM1272_READ_PIN, &raw)) { fail(\"pin raw read\"); return; }\n    report_int(\"pin_raw\", (long)raw);\n\n    e = adm1272_read_pin(ADDR, RS_UOHM, &pin);\n    if (e) { fail(\"read_pin failed\"); return; }\n    report_int(\"pin_mw\", pin);\n    report_fixed(\"pin_w\", pin, 3);\n\n    e = adm1272_read_vi(ADDR, RS_UOHM, &vin, &vout, &iout);\n    if (e) { fail(\"read_vi failed\"); return; }\n    report_int(\"vin_mv\", vin);\n}\n"
 ],
