 "test_ops": [
  "#include \"rt.h\"\n#include \"emc1403.h\"\n\nvoid op_main(void)\n{\n    long t0 = 0, t1 = 0, t2 = 0;\n    int id, rc;\n\n    id = emc1403_identify(0x18);\n    if (id < 0) { fail(\"emc1403 identify: bus error\"); return; }\n    report_int(\"id\", id);\n\n    rc = emc1403_read_all(0x18, &t0, &t1, &t2);\n    if (rc) { fail(\"emc1403 read_all failed\"); return; }\n\n    report_int(\"t0_mc\", t0);\n    report_int(\"t1_mc\", t1);\n    report_int(\"t2_mc\", t2);\n    report_int(\"t0_c\", t0 / 1000);\n    report_int(\"t1_c\", t1 / 1000);\n    report_int(\"t2_c\", t2 / 1000);\n    report_fixed(\"t0\", t0, 3);\n    report_fixed(\"t1\", t1, 3);\n    report_fixed(\"t2\", t2, 3);\n}\n",
  "#include \"rt.h\"\n#include \"emc1403.h\"\n\nvoid op_main(void)\n{\n    long t = 0, dummy = 0;\n    int rc;\n\n    rc = emc1403_read(0x18, (unsigned)P_CH, &t);\n    if (rc) { fail(\"emc1403 read failed\"); return; }\n\n    report_int(\"ch\", P_CH);\n    report_int(\"t_mc\", t);\n    report_int(\"t_c\", t / 1000);\n    report_fixed(\"t\", t, 3);\n\n    /* channel 3 does not exist: the fragment must refuse it without touching the bus */\n    rc = emc1403_read(0x18, 3, &dummy);\n    report_int(\"bad_ch_rc\", rc);\n}\n"
 ],
