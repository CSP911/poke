 static u64 t0, frq;
 static u64 cnt(void) { u64 v; __asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(v)); return v; }
-unsigned long ms(void) { return (unsigned long)((cnt() - t0) * 1000 / frq); }
-void delay_ms(unsigned long n) { if (n > 10000) n = 10000; u64 end = cnt() + n * frq / 1000; while (cnt() < end) {} }
+static unsigned long ms_(void) { return (unsigned long)((cnt() - t0) * 1000 / frq); }
 
+/* Per-target settings the hub patches into the image (find RCFG, write the next two words):
+ * the code bytes are the same on the twin and on a Pi. Twin: wdog=0 (QEMU resets the moment
+ * the watchdog is armed; the hub's QEMU time budget is the twin's watchdog). Pi: wdog=1. */
+static const volatile struct { u32 magic, wdog, budget_ms; } rtcfg
+    __attribute__((section(".rodata.rtcfg"), used, aligned(16))) = { 0x47464352u /* "RCFG" */, 0, 20000 };
+
+/* PM watchdog: 20-bit counter at 65536 Hz, so at most ~16 s. Armed at boot, fed only here
+ * (the op cannot: PM is outside every op window and this is not in rt.h), and only while the
+ * op is inside its budget. An op that loops without calling the runtime is reset ≤ 15 s after
+ * its last call; one that keeps calling is stopped gracefully at the budget below. */
+#define WDOG_TICKS 0xF0000u                       /* 15 s */
+static void wdog_feed(void) {
+    if (!rtcfg.wdog || ms_() >= rtcfg.budget_ms) return;
+    R(PM + 0x24) = PM_PASS | WDOG_TICKS;
+    R(PM + 0x1c) = PM_PASS | (R(PM + 0x1c) & ~0x30u) | 0x20;
+}
+static void finish(void);
+static int over_budget(void) { return ms_() >= rtcfg.budget_ms; }
+static void budget_stop(void);
+unsigned long ms(void) { wdog_feed(); if (over_budget()) budget_stop(); return ms_(); }
+void delay_ms(unsigned long n) {
+    if (n > 10000) n = 10000;
+    u64 end = cnt() + n * frq / 1000, next = cnt();
+    while (cnt() < end) { if (cnt() >= next) { wdog_feed(); if (over_budget()) budget_stop(); next = cnt() + frq; } }
+}
