{
  "_comment": "HEX — 10 QEMU edge configuration for smart office simulation",
  "edges": [
    {
      "id": "entrance",
      "name": "Entrance",
      "arch": "rv32",
      "port": 19001,
      "sensors": ["hcsr501"],
      "description": "PIR motion detection, door control"
    },
    {
      "id": "workspace-1",
      "name": "Workspace 1",
      "arch": "rv32",
      "port": 19002,
      "sensors": ["dht22", "relay_4ch"],
      "description": "Temperature/humidity, lighting & fan control"
    },
    {
      "id": "workspace-2",
      "name": "Workspace 2",
      "arch": "rv32",
      "port": 19003,
      "sensors": ["bh1750", "mq135"],
      "description": "Light level, air quality monitoring"
    },
    {
      "id": "climate",
      "name": "Climate Control",
      "arch": "rv32",
      "port": 19004,
      "sensors": ["ir_transmitter", "relay_2ch"],
      "description": "AC/TV IR control, ventilation fan"
    },
    {
      "id": "server-room",
      "name": "Server Room",
      "arch": "rv32",
      "port": 19005,
      "sensors": ["dht22", "relay_2ch"],
      "description": "Critical temperature monitoring, cooling fan"
    },
    {
      "id": "meeting",
      "name": "Meeting Room",
      "arch": "rv32",
      "port": 19006,
      "sensors": ["hcsr501", "relay_4ch", "ssd1306"],
      "description": "Occupancy, lighting, status display"
    },
    {
      "id": "kitchen",
      "name": "Kitchen",
      "arch": "rv32",
      "port": 19007,
      "sensors": ["mq135", "relay_2ch"],
      "description": "Gas/smoke detection, exhaust fan"
    },
    {
      "id": "parking",
      "name": "Parking",
      "arch": "rv32",
      "port": 19008,
      "sensors": ["hcsr501", "relay_2ch"],
      "description": "Motion detection, lighting control"
    },
    {
      "id": "rooftop",
      "name": "Rooftop",
      "arch": "rv32",
      "port": 19009,
      "sensors": ["dht22", "bmp280"],
      "description": "Weather station — temperature, humidity, pressure"
    },
    {
      "id": "lobby",
      "name": "Lobby",
      "arch": "rv32",
      "port": 19010,
      "sensors": ["hcsr501", "relay_4ch", "ssd1306"],
      "description": "Motion, lighting, welcome display"
    }
  ]
}
