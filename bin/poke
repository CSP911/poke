#!/usr/bin/env node
/* ============================================
 * poke — CLI for POKE edge devices (UDP)
 *
 *   poke ping                     liveness check
 *   poke info                     edge info (JSON)
 *   poke temp                     SoC temperature
 *   poke gpio                     read all GPIO pins
 *   poke gpio <pin> <0|1>         drive a GPIO pin
 *   poke time                     sync wall clock (local time)
 *   poke text <msg>               draw a message on the display
 *   poke persona <name>           transform: inject persona binary
 *   poke become "<request>"       LLM writes a persona from natural language,
 *                                 compiles it, and injects it
 *   poke voice                    speak the request instead (mic → whisper → become)
 *   poke listen                   daemon: receive autonomous device events
 *                                 (EVNT :5556) → LLM judges → notification + TTS
 *   poke hex                      always-on assistant: wake word "hex, ..."
 *                                 + event listener, in one daemon
 *                                 (POKE_LANG=ko for Korean: "헥스야, ...")
 *   poke persona stop             discard current persona
 *   poke home                     back to the boot banner screen
 *   poke resident <name>|stop     inject a resident driver from edge/library
 *                                 (device stacks live there, not in the kernel)
 *   poke residents                list resident drivers in the library
 *   poke check memory [--full]    hardware self-test: destructive RAM test of all
 *                                 free memory (chunked probes, progress on screen)
 *   poke check edac [--clear]     Cortex-A72 L1/L2 cache ECC/parity error registers
 *   poke kernel [img]             reload the kernel over the network (default: pi4 build)
 *   poke unit [bin]               run a binary as an EL0 process (own address space)
 *   poke personas                 list available personas
 *   poke cache                    list the self-growing persona cache
 *   poke burst "<task>"           distributed compute: LLM splits a CPU-burst
 *                                 job, one parameterized worker runs across a
 *                                 bare-metal x86 fleet, results are reduced
 *                                 (--edges N, --chunks M, --no-cache)
 *   poke workers                  list the self-growing worker cache
 *
 * Target: POKE_HOST env or --host <ip> (default 10.0.0.2)
 * Implementation lives in lib/cli/.
 * ============================================ */
const fs = require('fs')
const path = require('path')

const proto = require('../lib/cli/proto')
const { PERSONA_DIR, loadCatalog, become, setCurrent, clearCurrent } = require('../lib/cli/persona')
const { listen, voice, hexDaemon } = require('../lib/cli/daemon')
const residents = require('../lib/cli/residents')

const args = process.argv.slice(2)
const hostIdx = args.indexOf('--host')
const HOST = hostIdx >= 0 ? args.splice(hostIdx, 2)[1] : (process.env.POKE_HOST || '10.0.0.2')
const cmd = args.shift()

const request = proto.connect(HOST)
const { timePayload, opClear, opRect, opText } = proto

async function main() {
  switch (cmd) {
    case 'ping': {
      const t0 = Date.now()
      const r = await request(Buffer.from('PING'))
      console.log(`${r} (${Date.now() - t0}ms)`)
      break
    }
    case 'info':
      console.log(JSON.stringify(JSON.parse(await request(Buffer.from('INFO'))), null, 2))
      break
    case 'temp': {
      const j = JSON.parse(await request(Buffer.from('TEMP')))
      console.log(`${j.celsius}°C`)
      break
    }
    case 'gpio': {
      if (args.length >= 2) {
        const p = Buffer.alloc(6)
        p.write('GPOS', 0); p[4] = parseInt(args[0]); p[5] = parseInt(args[1]) ? 1 : 0
        console.log(await request(p))
      } else {
        console.log(await request(Buffer.from('GPIO')))
      }
      break
    }
    case 'time':
      console.log(await request(timePayload()))
      break
    case 'home':  /* discard persona, back to the boot banner screen */
      clearCurrent()
      console.log(await request(Buffer.from('PSTP')))
      break
    case 'text': {
      const msg = args.join(' ') || 'POKE'
      clearCurrent()
      await request(Buffer.from('PSTP'))  /* take the screen: discard any persona */
      const scale = Math.max(1, Math.min(8, Math.floor(84 / msg.length)))
      const ops = [
        opClear(0x00101828),
        opText(40, 200, scale, 0x0000FF66, msg),
        opRect(40, 200 + scale * 8 + 20, 720, 6, 0x0000FF66),
      ]
      console.log(await request(Buffer.concat([Buffer.from('DRAW'), ...ops])))
      break
    }
    case 'persona': {
      const name = args[0]
      if (!name) { console.error('usage: poke persona <name>|stop'); process.exit(1) }
      if (name === 'stop') { clearCurrent(); console.log(await request(Buffer.from('PSTP'))); break }
      const bin = fs.readFileSync(path.join(PERSONA_DIR, `${name}.bin`))
      if (bin.length > proto.PERSONA_MAX) throw new Error(`persona binary too large (${bin.length} > ${proto.PERSONA_MAX})`)
      await request(timePayload())  /* personas may need wall clock */
      const srcPath = path.join(PERSONA_DIR, `${name}.c`)
      await residents.ensureServices(request, residents.servicesUsed(null, fs.existsSync(srcPath) ? fs.readFileSync(srcPath, 'utf8') : ''))
      const r = JSON.parse(await proto.upload(request, 'PRUN', bin))
      setCurrent(name)
      console.log(`${name}: ${r.persona} (${r.size} bytes)`)
      break
    }
    case 'voice':
      await voice(request)
      break
    case 'listen':
      await listen()
      break
    case 'hex':
      await hexDaemon(request)
      break
    case 'burst': {
      const flag = (name, dflt) => {
        const i = args.indexOf(name)
        return i >= 0 ? parseInt(args.splice(i, 2)[1]) : dflt
      }
      const boolFlag = (name) => {
        const i = args.indexOf(name)
        if (i >= 0) { args.splice(i, 1); return true }
        return false
      }
      const nEdges = flag('--edges', 4)
      const nChunks = flag('--chunks', 0)
      const noCache = boolFlag('--no-cache')
      const task = args.join(' ')
      if (!task) { console.error('usage: poke burst "<task>" [--edges N] [--chunks M] [--no-cache]'); process.exit(1) }
      await require('../lib/cli/burst').burst(task, nEdges, nChunks, { noCache })
      break
    }
    case 'workers': {
      const cat = require('../lib/cli/burst').loadCatalog()
      if (!cat.length) { console.log('(no cached workers)'); break }
      for (const e of cat) {
        console.log(`${e.name} — ${e.description}`)
        console.log(`  params: ${e.params.map((p, i) => `PARAM${i}=${p}`).join(', ') || '(none)'}  reduce: ${e.reduce}, unit: ${e.unit}`)
      }
      break
    }
    case 'become': {
      const wish = args.join(' ')
      if (!wish) { console.error('usage: poke become "<request>"'); process.exit(1) }
      await become(request, wish)
      break
    }
    case 'cache': {
      const cat = loadCatalog()
      if (!cat.length) { console.log('(cache empty)'); break }
      for (const e of cat) {
        console.log(`${e.name} — ${e.description}`)
        console.log(`  params: ${e.params.map((p, i) => `[${i}] ${p.name}: ${p.desc}`).join('; ') || '(none)'}`)
      }
      break
    }
    case 'resident': {   /* inject a resident driver from the library, or stop it */
      const name = args[0]
      if (!name) { console.error('usage: poke resident <name>|stop'); process.exit(1) }
      if (name === 'stop') { console.log(await residents.stopResident(request)); break }
      const r = await residents.ensureResident(request, name)
      console.log(r.already ? `${name}: already running` : `${name}: running (${r.size} bytes)`)
      break
    }
    case 'residents': {  /* library index */
      const list = residents.list()
      if (!list.length) { console.log('(no residents in edge/library)'); break }
      for (const e of list) console.log(`${e.name} — provides ${(e.provides || []).join(', ')} — ${e.description}`)
      break
    }
    case 'check': {      /* hardware self-test, driven by the hub with library probes */
      const what = args[0]
      const check = require('../lib/cli/check')
      if (what === 'memory') await check.memory(request, { full: args.includes('--full'), uncached: args.includes('--uncached') })
      else if (what === 'edac') await check.edac(request, { clear: args.includes('--clear') })
      else { console.error('usage: poke check memory [--full] [--uncached] | poke check edac [--clear]'); process.exit(1) }
      break
    }
    case 'kernel': {     /* reload the running kernel over the network — no SD card swap */
      const img = args[0] || path.join(__dirname, '..', 'edge', 'kernel', 'pi4', 'kernel8.img')
      const bin = fs.readFileSync(img)
      const before = JSON.parse(await request(Buffer.from('INFO'))).build || '?'
      console.log(`current build ${before} → sending ${bin.length} bytes...`)
      console.log(await proto.upload(request, 'KRLD', bin, 30000))
      const t0 = Date.now()
      for (let i = 0; i < 40; i++) {
        try { const j = JSON.parse(await request(Buffer.from('INFO'), 1000)); console.log(`✦ back in ${((Date.now() - t0) / 1000).toFixed(1)}s — build ${j.build}${j.build === before ? '  (UNCHANGED?)' : ''}`); break }
        catch { if (i === 39) console.log('no answer after reload — power-cycle the device') }
      }
      break
    }
    case 'unit': {       /* run a binary as an EL0 process in its own address space */
      const img = args[0] || path.join(__dirname, '..', 'edge', 'library', 'pi4', 'hello-unit', 'unit.bin')
      const bin = fs.readFileSync(img)
      const r = JSON.parse(await proto.upload(request, 'URUN', bin, 30000))
      if (r.error) { console.log('error:', r.error); break }
      console.log(`unit exited code=${r.code} in ${r.ms}ms (${r.pages} pages)`)
      for (const l of (r.log || '').split('\n').filter(Boolean)) console.log('  │ ' + l)
      break
    }
    case 'personas': {
      const list = fs.readdirSync(PERSONA_DIR).filter((f) => f.endsWith('.bin')).map((f) => f.replace('.bin', ''))
      console.log(list.length ? list.join('\n') : '(none — run: make -C edge/kernel/pi4 personas)')
      break
    }
    default:
      console.error('usage: poke <ping|info|temp|gpio|time|text|persona|personas|resident|residents|check|kernel|unit|home|become|voice|listen|hex|cache|burst|workers> [--host ip]')
      process.exit(1)
  }
}

main().catch((e) => { console.error('error:', e.message); process.exit(1) })
