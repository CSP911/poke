{
  "id": "esp32c3_base",
  "name": "ESP32-C3 Base",
  "chip": "esp32c3",
  "arch": "riscv32",
  "match": { "chip": "esp32c3" },
  "description": "ESP32-C3 chip-level capabilities: GPIO, code execution, internal temperature sensor",
  "registers": {
    "GPIO_IN":      { "addr": "0x6000403C", "desc": "Read GPIO pin states (bit per pin)" },
    "GPIO_OUT":     { "addr": "0x60004004", "desc": "Set GPIO output levels" },
    "GPIO_ENABLE":  { "addr": "0x60004020", "desc": "Set GPIO pin direction (1=output)" },
    "TSENS_CTRL":   { "addr": "0x60040058", "desc": "Temperature sensor: bit22=PU, bits[21:14]=raw 8-bit value" },
    "TSENS_CTRL2":  { "addr": "0x6004005C", "desc": "Temperature sensor ctrl2: bit14=XPD_FORCE" },
    "EFUSE_MAC_LO": { "addr": "0x60008844", "desc": "eFuse MAC address low 32 bits" },
    "EFUSE_MAC_HI": { "addr": "0x60008848", "desc": "eFuse MAC address high 16 bits" },
    "TIMG0_LO":     { "addr": "0x6001F004", "desc": "Timer Group 0 counter low" },
    "WIFI_CLK_EN":  { "addr": "0x60026014", "desc": "WiFi peripheral clock enable (write 0xFFFFFFFF to enable all)", "status": "verified" },
    "WIFI_RST_EN":  { "addr": "0x60026018", "desc": "WiFi peripheral reset (write 0 to release)", "status": "verified" },
    "WIFI_MAC_BASE":{ "addr": "0x60033000", "desc": "WiFi MAC registers base", "status": "verified" },
    "WIFI_RX_EN":   { "addr": "0x60033084", "desc": "WiFi receiver enable/disable", "status": "incubating" },
    "WIFI_DMA_BASE":{ "addr": "0x60033088", "desc": "WiFi DMA linked-list base address", "status": "incubating" },
    "WIFI_POWER":   { "addr": "0x60033CA0", "desc": "WiFi module power control", "status": "verified" },
    "WIFI_TX_DMA":  { "addr": "0x60033D08", "desc": "WiFi transmit DMA address + trigger", "status": "incubating" },
    "WIFI_INT_RAW": { "addr": "0x60033C3C", "desc": "WiFi interrupt reason", "status": "incubating" },
    "WIFI_INT_CLR": { "addr": "0x60033C40", "desc": "WiFi interrupt clear", "status": "incubating" },
    "BB_BASE":      { "addr": "0x6001D000", "desc": "Baseband processor registers", "status": "verified" },
    "RF_FE_BASE":   { "addr": "0x60006000", "desc": "RF front-end registers", "status": "incubating" }
  },
  "calibration": {
    "temp_raw_to_celsius": "celsius ≈ raw * 0.44 - 28 (approximate, chip-dependent)"
  },
  "operations": [
    {
      "name": "read_temp",
      "desc": "Read internal temperature sensor (calibrated, celsius)",
      "type": "sensor",
      "protocol": "command",
      "command": "TEMP",
      "returns": "JSON with celsius value",
      "tags": ["temperature", "sensor", "internal", "calibrated"]
    },
    {
      "name": "read_gpio",
      "desc": "Read all GPIO pin states (GPIO 0-10)",
      "type": "sensor",
      "protocol": "command",
      "command": "GPIO",
      "returns": "JSON with pin states",
      "tags": ["gpio", "input", "digital"]
    },
    {
      "name": "set_gpio",
      "desc": "Set a GPIO pin output (for LED, relay, motor control)",
      "type": "actuator",
      "protocol": "command",
      "command": "GPOS",
      "params": ["pin", "value"],
      "returns": "JSON with pin and value set",
      "tags": ["gpio", "output", "digital"]
    },
    {
      "name": "monitor_gpio",
      "desc": "Deploy autonomous GPIO interrupt monitor. Fires EVNT when triggered.",
      "type": "monitor",
      "protocol": "command",
      "command": "EMON",
      "config": { "type": 1 },
      "params": ["pin", "edge_trigger"],
      "returns": "Confirmation of monitor deployment",
      "tags": ["gpio", "interrupt", "monitor", "event"]
    },
    {
      "name": "monitor_temp",
      "desc": "Deploy autonomous temperature threshold monitor. Fires EVNT when threshold crossed.",
      "type": "monitor",
      "protocol": "command",
      "command": "EMON",
      "config": { "type": 2 },
      "params": ["op", "threshold", "interval_ms"],
      "returns": "Confirmation of monitor deployment",
      "tags": ["temperature", "threshold", "monitor", "event"]
    },
    {
      "name": "stop_monitors",
      "desc": "Stop all active event monitors on this edge",
      "type": "control",
      "protocol": "command",
      "command": "ESTOP",
      "returns": "Confirmation",
      "tags": ["monitor", "stop"]
    },
    {
      "name": "execute_code",
      "desc": "Execute arbitrary RISC-V (RV32IM) machine code on bare metal",
      "type": "compute",
      "protocol": "command",
      "command": "EXEC",
      "params": ["machine_code"],
      "returns": "a0 register value",
      "tags": ["compute", "risc-v", "bare-metal"]
    }
  ]
}
