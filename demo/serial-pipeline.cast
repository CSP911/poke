[2.024, "o", "\r\n▶ Step 3: RISC-V arithmetic (hub compile → serial → ESP32 execute)\r\n"]
[0.000, "o", "─────────────────────────────────────────\r\n"]
[1.051, "o", "\r\n"]
[0.001, "o", "  ┌─ 3 + 4 = 7\r\n"]
[0.000, "o", "  │ ASM:\r\n"]
[0.000, "o", "  │   li a0, 3\r\n"]
[0.000, "o", "  │   li t0, 4\r\n"]
[0.000, "o", "  │   add a0, a0, t0\r\n"]
[0.000, "o", "  │   ret\r\n"]
[0.001, "o", "[INFO] [asm_rv.js] assembled 16 bytes\r\n"]
[0.000, "o", "  │ BIN: 13053000930240003305550067800000 (16 bytes)\r\n"]
[0.026, "o", "  └─ ✅ Result: a0=7\r\n\r\n  ┌─ 10 × 20 = 200\r\n"]
[0.000, "o", "  │ ASM:\r\n"]
[0.000, "o", "  │   li a0, 10\r\n"]
[0.000, "o", "  │   li t0, 20\r\n  │   mul a0, a0, t0\r\n"]
[0.000, "o", "  │   ret\r\n"]
[0.000, "o", "[INFO] [asm_rv.js] assembled 16 bytes\r\n"]
[0.000, "o", "  │ BIN: 1305a000930240013305550267800000 (16 bytes)\r\n"]
[0.003, "o", "  └─ ✅ Result: a0=200\r\n"]
[0.000, "o", "\r\n  ┌─ 100 - 37 = 63\r\n  │ ASM:\r\n  │   li a0, 100\r\n"]
[0.000, "o", "  │   li t0, 37\r\n"]
[0.000, "o", "  │   sub a0, a0, t0\r\n  │   ret\r\n"]
[0.000, "o", "[INFO] [asm_rv.js] assembled 16 bytes\r\n"]
[0.000, "o", "  │ BIN: 13054006930250023305554067800000 (16 bytes)\r\n"]
[0.002, "o", "  └─ ✅ Result: a0=63\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  ┌─ fibonacci(10) = 55\r\n  │ ASM:\r\n  │   li a0, 0\r\n"]
[0.000, "o", "  │   li a1, 1\r\n"]
[0.000, "o", "  │   li t0, 10\r\n  │   li t1, 0\r\n  │   loop:\r\n"]
[0.000, "o", "  │   beq t1, t0, done\r\n  │   add t2, a0, a1\r\n  │   mv a0, a1\r\n"]
[0.000, "o", "  │   mv a1, t2\r\n"]
[0.000, "o", "  │   addi t1, t1, 1\r\n  │   j loop\r\n"]
[0.000, "o", "  │   done:\r\n  │   ret\r\n"]
[0.000, "o", "[INFO] [asm_rv.js] assembled 44 bytes\r\n"]
[0.000, "o", "  │ BIN: 13050000930510009302a00013030000630c5300b303b5001385050093850300130313006ff0dffe67800000 (44 bytes)\r\n"]
[0.003, "o", "  └─ ✅ Result: a0=55\r\n"]
